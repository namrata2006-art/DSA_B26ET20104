
#include <stdio.h>
#include <ctype.h>
#include <stdlib.h>

#define MAX 100

int stack[MAX];
int top = -1;

void push(int value) {
    if (top >= MAX - 1) {
        printf("Stack Overflow!\n");
        exit(1);
    }
    stack[++top] = value;
}

int pop() {
    if (top == -1) {
        printf("Invalid Expression: Stack Underflow!\n");
        exit(1);
    }
    return stack[top--];
}

int evaluatePostfix(char exp[]) {
    int i, a, b, result;

    top = -1;  // Reset stack before evaluation

    for (i = 0; exp[i] != '\0' && exp[i] != '\n'; i++) {

        if (exp[i] == ' ')
            continue;

        if (isdigit((unsigned char)exp[i])) {
            push(exp[i] - '0');
        }
        else {
            b = pop();
            a = pop();

            switch (exp[i]) {
                case '+': result = a + b; break;
                case '-': result = a - b; break;
                case '*': result = a * b; break;

                case '/':
                    if (b == 0) {
                        printf("Division by zero!\n");
                        exit(1);
                    }
                    result = a / b;
                    break;

                default:
                    printf("Invalid Operator!\n");
                    exit(1);
            }

            push(result);
        }
    }

    if (top != 0) {
        printf("Invalid Postfix Expression!\n");
        exit(1);
    }

    return pop();
}

int main() {
    char exp[MAX];

    printf("Enter postfix expression: ");
    fgets(exp, MAX, stdin);

    printf("Result = %d\n", evaluatePostfix(exp));

    return 0;
}
